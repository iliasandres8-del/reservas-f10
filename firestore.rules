rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo Andrés (su correo, verificado por Firebase Auth) puede ver y editar
    function esAndres() {
      return request.auth != null && request.auth.token.email == 'iliasandres8@gmail.com';
    }
    function reservaValida(d) {
      return d.cliente is string && d.cliente.size() > 0 && d.cliente.size() <= 80
        && d.fecha is string && d.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.cancha is int && d.cancha >= 1 && d.cancha <= 4
        && d.inicio is number && d.duracion is number && d.duracion > 0 && d.duracion <= 6
        && d.valor is number && d.valor >= 0 && d.abono is number && d.abono >= 0
        && d.estado in ['pendiente', 'abonada', 'pagada', 'cancelada'];
    }
    match /reservas/{id} {
      allow read, delete: if esAndres();
      allow create, update: if esAndres() && reservaValida(request.resource.data);
    }
    match /ajustes/{id} {
      allow read, write: if esAndres();
    }

    // App "Suma de pagos": la cuenta interna de la app (entra con el PIN) y Andrés
    function esSuma() {
      return request.auth != null && request.auth.token.email in ['pagos@club-f10.app', 'iliasandres8@gmail.com'];
    }
    function pagoValido(d) {
      return d.valor is number && d.valor >= 0 && d.valor <= 100000000
        && d.fecha is string && d.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('mini' in d) || (d.mini is string && d.mini.size() < 60000));
    }
    match /pagos/{id} {
      allow read, delete: if esSuma();
      allow create, update: if esSuma() && pagoValido(request.resource.data);
    }
  }
}
